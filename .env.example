# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite+aiosqlite:///./fraud_detection.db

# Paths
RULES_CONFIG_PATH=config/rules.yaml
FEATURE_FLAGS_PATH=config/feature_flags.yaml
AB_EXPERIMENTS_PATH=config/ab_experiments.yaml
ML_ARTIFACTS_DIR=ml/artifacts

# Security
API_KEY=dev-api-key-change-in-production

# ML
DEFAULT_MODEL_VERSION=1
CONTAMINATION_RATE=0.05
